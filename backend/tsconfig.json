{
    "compilerOptions": {
        "noImplicitAny": true,
        "strictNullChecks": true,
        "alwaysStrict": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "outDir": "dist",
        "module": "node20",
        "moduleResolution": "node16",
        "target": "es2017",
        "lib": ["es2017", "dom"],
        "jsx": "react-jsx",
        "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}